<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyFirstApp.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MyFirstApp.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,24" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Fitness calculators" />
            <TextBlock
                Opacity="0.8"
                Text="Choose a calculation to get started."
                TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                MaxWidth="840"
                HorizontalAlignment="Center"
                ColumnSpacing="16"
                RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button
                    MinHeight="144"
                    Padding="20"
                    HorizontalContentAlignment="Stretch"
                    Click="BmiCalculatorButton_Click">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="BMI calculator" />
                        <TextBlock
                            Opacity="0.8"
                            Text="Estimate body mass index from height and weight."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="1"
                    MinHeight="144"
                    Padding="20"
                    IsEnabled="False"
                    HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Calorie needs" />
                        <TextBlock
                            Opacity="0.8"
                            Text="Coming soon"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Row="1"
                    MinHeight="144"
                    Padding="20"
                    IsEnabled="False"
                    HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="BMR calculator" />
                        <TextBlock
                            Opacity="0.8"
                            Text="Coming soon"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    MinHeight="144"
                    Padding="20"
                    IsEnabled="False"
                    HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Body fat estimate" />
                        <TextBlock
                            Opacity="0.8"
                            Text="Coming soon"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
