<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyFirstApp.Pages.BmiCalculatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MyFirstApp.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="16">
            <Button
                VerticalAlignment="Center"
                Click="BackToMenuButton_Click"
                Content="Back to main menu" />
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="BMI calculator" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="480" HorizontalAlignment="Left" Spacing="20">
                <TextBlock Text="Estimate your body mass index from your height and weight." TextWrapping="Wrap" />

                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="Units" />
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <RadioButton
                            x:Name="MetricUnitsRadioButton"
                            IsChecked="True"
                            GroupName="BmiUnits"
                            Content="Metric" />
                        <RadioButton
                            x:Name="ImperialUnitsRadioButton"
                            GroupName="BmiUnits"
                            Content="Imperial" />
                    </StackPanel>
                </StackPanel>

                <NumberBox
                    x:Name="HeightInput"
                    Header="Height (cm)"
                    PlaceholderText="For example, 170"
                    Minimum="0"
                    Maximum="300"
                    SmallChange="1" />
                <NumberBox
                    x:Name="WeightInput"
                    Header="Weight (kg)"
                    PlaceholderText="For example, 70"
                    Minimum="0"
                    Maximum="500"
                    SmallChange="1" />

                <Button
                    HorizontalAlignment="Left"
                    Click="CalculateButton_Click"
                    Content="Calculate BMI" />

                <StackPanel Spacing="4" Margin="0,8,0,0">
                    <TextBlock x:Name="BmiValueText" FontSize="32" FontWeight="SemiBold" Text="--" />
                    <TextBlock x:Name="BmiCategoryText" FontSize="18" Text="Enter your measurements to begin." />
                    <TextBlock
                        FontSize="12"
                        Opacity="0.75"
                        Text="BMI is a screening measure, not a diagnosis. Categories shown apply to adults."
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
